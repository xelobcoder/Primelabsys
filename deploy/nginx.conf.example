server {
    listen 80;
    server_name primelabsys.com www.primelabsys.com;
    return 301 https://primelabsys.com$request_uri;
}

# Create a separate www TLS redirect only after the certificate covers the host.
server {
    listen 443 ssl http2;
    server_name www.primelabsys.com;
    ssl_certificate /etc/letsencrypt/live/primelabsys.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/primelabsys.com/privkey.pem;
    return 301 https://primelabsys.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name primelabsys.com;
    ssl_certificate /etc/letsencrypt/live/primelabsys.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/primelabsys.com/privkey.pem;
    client_max_body_size 16k;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:2380;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:2380;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:2380/api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Enable HSTS only after confirming HTTPS is permanent for this domain.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
