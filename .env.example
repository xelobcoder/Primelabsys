# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://primelabsys.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Lead delivery: use an HTTPS webhook operated by your approved CRM or email service.
# The site returns an unavailable response until both values are configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Optional facility and patient portal entry points. Each destination must use HTTPS
# and its hostname must appear in the comma-separated allowlist below.
PLS_FACILITY_PORTAL_URL=
PLS_PATIENT_PORTAL_URL=
PLS_PORTAL_ALLOWED_HOSTS=
PLS_PORTAL_ALLOW_LOOPBACK_HTTP=false

# Optional Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Public facility catalogs and marketplace endpoints are fetched/proxied server-to-server.
# Keep this origin server-only; never expose credentials or tenant identifiers here.
CORE_PLATFORM_API_URL=
CORE_PLATFORM_ALLOWED_ORIGIN=
# Set true only when the website and Lobnos Server run on the same machine.
# Allows explicit loopback HTTP upstreams with pnpm start; remote HTTP stays blocked.
CORE_PLATFORM_ALLOW_LOOPBACK_HTTP=false
